{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "networkSecurityGroups_nsg_trinity_servers_name": {
            "defaultValue": "nsg-trinity-servers",
            "type": "String"
        }
    },
    "variables": {},
    "resources": [
        {
            "type": "Microsoft.Network/networkSecurityGroups",
            "apiVersion": "2025-09-01",
            "name": "[parameters('networkSecurityGroups_nsg_trinity_servers_name')]",
            "location": "northcentralus",
            "tags": {
                "project": "trinity-dental",
                "env": "lab"
            },
            "properties": {
                "securityRules": [
                    {
                        "name": "Allow-RDP-MyIP",
                        "id": "[resourceId('Microsoft.Network/networkSecurityGroups/securityRules', parameters('networkSecurityGroups_nsg_trinity_servers_name'), 'Allow-RDP-MyIP')]",
                        "properties": {
                            "sourcePortRange": "*",
                            "destinationPortRange": "3389",
                            "sourceAddressPrefix": "<my-home-IP>",
                            "destinationAddressPrefix": "*",
                            "priority": 100,
                            "protocol": "TCP",
                            "access": "Allow",
                            "direction": "Inbound",
                            "sourcePortRanges": [],
                            "destinationPortRanges": [],
                            "sourceAddressPrefixes": [],
                            "destinationAddressPrefixes": []
                        }
                    }
                ]
            }
        },
        {
            "type": "Microsoft.Network/networkSecurityGroups/securityRules",
            "apiVersion": "2025-09-01",
            "name": "[concat(parameters('networkSecurityGroups_nsg_trinity_servers_name'), '/Allow-RDP-MyIP')]",
            "dependsOn": [
                "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('networkSecurityGroups_nsg_trinity_servers_name'))]"
            ],
            "properties": {
                "sourcePortRange": "*",
                "destinationPortRange": "3389",
                "sourceAddressPrefix": "<my-home-IP>",
                "destinationAddressPrefix": "*",
                "priority": 100,
                "protocol": "TCP",
                "access": "Allow",
                "direction": "Inbound",
                "sourcePortRanges": [],
                "destinationPortRanges": [],
                "sourceAddressPrefixes": [],
                "destinationAddressPrefixes": []
            }
        }
    ]
}